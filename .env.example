# Navain AI — environment variables
#
# Do NOT put real keys in this file and do NOT commit a real .env file.
# These values belong in Vercel → Project → Settings → Environment Variables.
# After adding them, redeploy the project — the serverless functions in /api
# read them at runtime, so the key never reaches the browser.
#
# Enables /api/chat (Stacy the assistant) and /api/speak (text-to-speech).
# Get a key at https://console.groq.com
GROQ_API_KEY=

# Optional overrides:
# GROQ_MODEL=llama-3.1-8b-instant
# TTS_VOICE=Aaliyah-PlayAI
